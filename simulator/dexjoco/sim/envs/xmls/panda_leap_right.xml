  <!-- ========================= CONTACT (merge, adjust allegro palm name) ========================= -->
  <contact>
    <!-- panda original excludes -->
   
    <exclude body1="mcp_joint" body2="pip"/>
    <exclude body1="pip" body2="dip"/>
    <exclude body1="dip" body2="fingertip"/>
    <exclude body1="mcp_joint_2" body2="pip_2"/>
    <exclude body1="pip_2" body2="dip_2"/>
    <exclude body1="dip_2" body2="fingertip_2"/>
    <exclude body1="mcp_joint_3" body2="pip_3"/>
    <exclude body1="pip_3" body2="dip_3"/>
    <exclude body1="dip_3" body2="fingertip_3"/>
    <exclude body1="fingertip" body2="dip_2"/>
    <exclude body1="fingertip_2" body2="dip_3"/>

    <!-- Adjacent thumb links should not collide with each other; otherwise the
         position actuators fight internal contacts before the thumb visibly bends. -->
    <exclude body1="pip_4" body2="thumb_pip"/>
    <exclude body1="pip_4" body2="thumb_dip"/>
    <exclude body1="thumb_pip" body2="thumb_dip"/>
    <exclude body1="thumb_dip" body2="thumb_fingertip"/>
    <!-- Match the bimanual LEAP model: thumb opposition sweeps through the
         palm volume, and these internal contacts can hold the thumb open. -->
    <exclude body1="leap_palm" body2="thumb_pip"/>
    <exclude body1="leap_palm" body2="thumb_dip"/>
    <exclude body1="leap_palm" body2="thumb_fingertip"/>
    <exclude body1="pip_4" body2="leap_palm"/>
  </contact>

